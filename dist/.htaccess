<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Canonical host: HTTPS + non-www
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.friendsgrp\.com$ [NC]
RewriteRule ^ https://friendsgrp.com%{REQUEST_URI} [R=301,L,NE]

# Retire obsolete indexed URLs
RewriteRule ^(?:reservation|spa-reservation)/?$ /menu/ [R=301,L,NE]
RewriteRule ^hotel-reservation/?$ /#booking [R=301,L,NE]
RewriteRule ^programs(?:/.*)?$ /menu/ [R=301,L,NE]

# cPanel API compatibility
RewriteRule ^api/promotions$ /api/promotions.php [L,QSA]
RewriteRule ^api/status$ /api/status.php [L,QSA]
RewriteRule ^backend/promotions$ /api/promotions.php [L,QSA]
RewriteRule ^backend/status$ /api/status.php [L,QSA]

# React Router fallback
RewriteRule ^index\.html$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.html [L]
</IfModule>
